{
  "name": "boai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKER",
        "class_name": "MatchmakerDO"
      },
      {
        "name": "MATCHES",
        "class_name": "MatchDO"
      },
      {
        "name": "LEDGER",
        "class_name": "LedgerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MatchmakerDO",
        "MatchDO",
        "LedgerDO"
      ]
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/health"]
  },
  "vars": {
    "WEB_ORIGIN": "https://boai-api.arkha10-boai.workers.dev",
    "BOAI_ENV": "production",
    "MONAD_RPC_URL": "https://rpc-testnet.monadinfra.com",
    "MONAD_CHAIN_ID": "10143",
    "BOAI_CONTRACT_ADDRESS": "0x5af642ed0427567b0dfd5ecd9474f174dbda8420"
  }
}
