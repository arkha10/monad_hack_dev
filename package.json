{
  "name": "boai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worker.json",
    "build": "vite build --config apps/web/vite.config.ts && wrangler deploy --dry-run --config apps/worker/wrangler.jsonc",
    "test": "vitest run",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:worker": "wrangler dev --local --config apps/worker/wrangler.jsonc",
    "test:browser": "playwright test",
    "test:contracts": "forge test --root contracts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "@supabase/supabase-js": "2.118.0",
    "viem": "2.57.10",
    "jose": "6.2.13",
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "wrangler": "4.152.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "vitest": "5.0.5",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.64.1"
  }
}
